{
  "name": "demo-store-backend",
  "version": "1.0.0",
  "description": "demo-store-backend — E-commerce backend generated by BackendForge",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:generate": "npx sequelize-cli migration:generate --name",
    "seed": "node src/seeds/run.js",
    "seed:undo": "node src/seeds/undo.js",
    "health": "curl -s http://localhost:3000/api/health | node -e \"process.stdin.resume();process.stdin.on('data',d=>console.log(JSON.parse(d)))\""
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "joi": "^17.13.3",
    "bcryptjs": "^2.4.3",
    "express-rate-limit": "^7.4.1",
    "hpp": "^0.2.3",
    "xss-clean": "^0.1.4",
    "winston": "^3.14.2",
    "uuid": "^10.0.0",
    "http-status-codes": "^2.3.0",
    "sequelize": "^6.37.4",
    "pg": "latest",
    "pg-hstore": "^2.3.4",
    "redis": "^4.7.0",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^17.1.0",
    "twilio": "^5.3.3",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "eslint": "^9.12.0",
    "sequelize-cli": "^6.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
